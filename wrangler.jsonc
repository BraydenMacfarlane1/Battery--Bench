{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bess-sizer",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  // workers.dev until a custom domain is attached. Account is chosen at login; do not hard-code account_id.
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Public base URL only. The export token is a secret, never a var: `npx wrangler secret put SUN_DADDY_EXPORT_TOKEN`
  "vars": {
    "SUN_DADDY_BASE_URL": "https://commercial-app.pages.dev"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
